# --- LLM (OpenAI-compatible; DeepSeek) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Vision / multimodal (AI reads shared screen) + low-latency voice LLM ---
GEMINI_API_KEY=
LLM_VISION_MODEL=gemini-2.5-flash

# --- STT ---
DEEPGRAM_API_KEY=
STT_MODEL=nova-2

# --- TTS ---
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
TTS_MODEL=eleven_flash_v2_5

# --- LiveKit (self-hosted; reuse /data/livekit) ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=interviewer

# --- Info search ---
TAVILY_API_KEY=
XHS_COOKIE=
ZHIHU_D_COOKIE=

# --- Kimi Code K2.7 vision (screen reading) ---
KIMI_API_KEY=
KIMI_MODEL=kimi-for-coding
KIMI_BASE_URL=https://api.kimi.com/coding/v1
